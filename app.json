{
  "expo": {
    "name": "PrimaLux Care",
    "slug": "plx-caregiver",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plxcaregiver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.primalux.caregiver",
      "infoPlist": {
        "NSHealthShareUsageDescription": "PrimaLux Care reads steps, heart rate, and sleep on this iPhone after you allow it. Readings stay on this device unless you choose to share a daily summary.",
        "NSHealthUpdateUsageDescription": "PrimaLux Care can save a pulse reading you type. It does not change other Apple Health data."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3D6B5A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EB"
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "PrimaLux Care reads steps, heart rate, and sleep on this iPhone after you allow it. Readings stay on this device unless you choose to share a daily summary.",
          "healthUpdatePermission": "PrimaLux Care can save a pulse reading you type. It does not change other Apple Health data.",
          "isBackgroundDeliveryEnabled": false,
          "isClinicalDataEnabled": false,
          "healthConnectPermissions": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
